# Server Port
PORT=5000

# MongoDB Connection URI
# Local MongoDB Community Server:
MONGODB_URI=mongodb://127.0.0.1:27017/gym_management
# MongoDB Atlas (uncomment and replace with your cluster URI if using cloud):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/gym_management?retryWrites=true&w=majority

# JWT Signing Secret
JWT_SECRET=flexi-jwt-secret-key-college-project-2026

# Environment
NODE_ENV=development

# Allowed Frontend Origin (for CORS)
CLIENT_URL=http://localhost:3000

# Optional: Google Gemini API Key for AI Fitness Coach
GEMINI_API_KEY=

